{
  "name": "template-goblin",
  "version": "0.6.0",
  "description": "PDF template engine — load a .tgbl template + JSON data, generate PDFs at scale",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./validateManifest": {
      "types": "./dist/validateManifest.d.ts",
      "import": "./dist/validateManifest.js"
    },
    "./assetRefs": {
      "types": "./dist/assetRefs.d.ts",
      "import": "./dist/assetRefs.js"
    }
  },
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/JaiminPatel345/template-goblin.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/JaiminPatel345/template-goblin#readme",
  "keywords": [
    "pdf",
    "template",
    "generator",
    "pdfkit",
    "template-engine",
    "pdf-generation"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('README.md','dist/README.md')\"",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "test": "jest"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "adm-zip": "^0.5.16",
    "pdfkit": "^0.15.1"
  },
  "devDependencies": {
    "@template-goblin/types": "workspace:*",
    "@types/adm-zip": "^0.5.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.0",
    "@types/pdfkit": "^0.13.5",
    "jest": "^29.7.0",
    "pdfjs-dist": "3.11.174",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "@template-goblin/types": "workspace:*"
  },
  "comment:adm-zip": "ZIP extraction/creation for .tgbl files (Node.js)",
  "comment:pdfkit": "PDF generation engine — renders text, images, tables to PDF Buffer",
  "comment:pdfjs-dist": "DEV-ONLY: parses generated PDFs in tests to assert layout/geometry (text positions + spacing) matches the template/canvas. Pinned to v3 (last major with a CommonJS legacy build) because the Jest runtime here evaluates node_modules as CJS."
}
